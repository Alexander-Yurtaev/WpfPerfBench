<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ShadowPasswordBoxStyle"
               TargetType="PasswordBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5 7"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>

        <!-- Отключаем стандартную рамку -->
        <Setter Property="BorderThickness" Value="0"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <!-- Основной Border с радиусом и тенью -->
                    <Border x:Name="Bd"
                            CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2">

                        <!-- Тень применяем именно сюда -->
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" 
                                              ShadowDepth="0"
                                              Color="{TemplateBinding BorderBrush}" 
                                              Opacity="0.3"/>
                        </Border.Effect>

                        <!-- ScrollViewer нужен для длинного текста -->
                        <ScrollViewer x:Name="PART_ContentHost" 
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>

                    </Border>

                    <!-- Триггеры для состояния ошибки и фокуса -->
                    <ControlTemplate.Triggers>
                        <!-- Состояние "При наведении" -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>

                        <!-- Состояние "В фокусе" -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" 
                                                      ShadowDepth="0"
                                                      Color="{DynamicResource AccentColor}" 
                                                      Opacity="0.25"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Danger}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                            <!--<Setter Property="ToolTip" 
                                        Value="{Binding RelativeSource={RelativeSource Self},
                                                                Path=(Validation.Errors)[0].ErrorContent}"/>-->
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6" 
                                                      ShadowDepth="0" 
                                                      Color="{DynamicResource DangerColor}" 
                                                      Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!--<Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A6ADB8"/>
                            </Trigger>-->
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormPasswordBoxStyle"
           TargetType="PasswordBox"
           BasedOn="{StaticResource ShadowPasswordBoxStyle}">
        <Setter Property="Background" Value="{DynamicResource BgInput}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Success}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="IsEnabled" Value="False"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding NavigationService.CurrentPage}" Value="Init">
                <Setter Property="IsEnabled" Value="True"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>