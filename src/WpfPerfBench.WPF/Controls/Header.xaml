<UserControl x:Class="WpfPerfBench.WPF.Controls.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:WpfPerfBench.WPF.Controls"
             xmlns:designViewModels1="clr-namespace:WpfPerfBench.WPF.DesignViewModels"
             mc:Ignorable="d"
             d:DesignWidth="950"
             d:DataContext="{d:DesignInstance Type=designViewModels1:DesignHeader, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConv"/>
        <Style TargetType="Image">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Margin" Value="0 0 6 0"/>
        </Style>
        <Style  x:Key="TextBlockBaseStyle"
                TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TitleTextBlockStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource TextBlockBaseStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="DescriptionTextBlockStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource TextBlockBaseStyle}">
        </Style>
        <Style x:Key="ThemeSwitcherStyle"
               TargetType="controls:ThemeSwitcher">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="25 0"/>
        </Style>
        <Style x:Key="ButtonCloseStyle"
               TargetType="Button"
               BasedOn="{StaticResource BtnCloseStyle}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border>
        <Grid>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Stretch">
                <Border BorderThickness="0 0 0 2"
                        BorderBrush="{DynamicResource Accent}"
                        Margin=" 0 0 0 5"
                        Padding="0 0 0 3"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding IconPath}"/>
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock Text=" - "
                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConv}}"
                                   Style="{StaticResource DescriptionTextBlockStyle}"/>
                        <TextBlock Text="{Binding Description}"
                                   Style="{StaticResource DescriptionTextBlockStyle}"/>
                    </StackPanel>
                </Border>
                <controls:ThemeSwitcher DataContext="{Binding ThemeManager}"
                                     Style="{StaticResource ThemeSwitcherStyle}"/>
            </StackPanel>
            
            <Button Content="✕" 
                    Command="ApplicationCommands.Close"
                    Style="{StaticResource ButtonCloseStyle}"/>
        </Grid>
    </Border>
</UserControl>
