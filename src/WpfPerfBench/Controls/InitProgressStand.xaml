<UserControl x:Class="WpfPerfBench.Controls.InitProgressStand"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Controls"
             mc:Ignorable="d" 
             d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="MainBorderStyle"
               TargetType="Border">
            <Setter Property="Margin" Value="20"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
            <Setter Property="Padding" Value="15"/>
        </Style>
        <Style x:Key="RoundedProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="{StaticResource BgProgress}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- Внешний Border (фон) -->
                            <Border x:Name="PART_Track"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <!-- Основной Border с закруглением -->
                                    <Border x:Name="PART_Indicator"
                                            CornerRadius="8"
                                            Background="{TemplateBinding Foreground}"
                                            HorizontalAlignment="Left"
                                            Width="{Binding ElementName=PART_Track, Path=ActualWidth}"/>
                                </Grid>
                            </Border>

                            <!-- Текст прогресса (опционально) -->
                            <TextBlock x:Name="ProgressText"
                                       Text="{Binding Value, 
                                              RelativeSource={RelativeSource TemplatedParent}, 
                                              StringFormat={}{0:0}%}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Visibility="Collapsed"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Показывать текст только если значение > 0 -->
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="ProgressText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Value" Value="100">
                                <Setter TargetName="ProgressText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProgressLabelStyle"
               TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0 6 0 0"/>
        </Style>
        <Style x:Key="ProgressStatusStyle"
               TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Success}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0 8 0 0"/>
        </Style>
        <Style x:Key="ProgressMessageStyle"
               TargetType="Label">
            <Setter Property="Margin" Value="0 4 0 0"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource MainBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0" 
                         Minimum="0" 
                         Maximum="100" 
                         Value="75"
                         Style="{StaticResource RoundedProgressBarStyle}"/>
            <Label Grid.Row="1"
                   Content="{Binding RelativeSource={RelativeSource AncestorType=local:InitProgressStand}, Path=ProgressLabel}"
                   Style="{StaticResource ProgressLabelStyle}"/>
            <Label Grid.Row="2"
                   Content="{Binding RelativeSource={RelativeSource AncestorType=local:InitProgressStand}, Path=ProgressStatus}"
                   Style="{StaticResource ProgressStatusStyle}"/>
            <Grid Grid.Row="3"
                  Margin="0 8 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"
                       Content="📊 Найдено записей: "
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"/>
                <Label Grid.Column="1"
                       Content="{Binding RelativeSource={RelativeSource AncestorType=local:InitProgressStand}, Path=TotalRecords}"
                       FontSize="13"
                       Foreground="{StaticResource Accent}"/>
            </Grid>
            <Label Grid.Row="4"
                   Content="{Binding RelativeSource={RelativeSource AncestorType=local:InitProgressStand}, Path=ProgressMessage}"
                   Style="{StaticResource ProgressMessageStyle}"/>
        </Grid>
    </Border>
</UserControl>
