<UserControl x:Class="WpfPerfBench.Controls.InitProgressStand"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="207.0666666666666" d:DesignWidth="504">

    <UserControl.Resources>
        <Style x:Key="MainBorderStyle"
               TargetType="Border">
            <Setter Property="Margin" Value="20"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
            <Setter Property="Padding" Value="15"/>
        </Style>
        <Style x:Key="RoundedProgressBarStyleTmp" TargetType="ProgressBar">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="{StaticResource BgProgress}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- Внешний Border (фон) -->
                            <Border x:Name="PART_Track"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <!-- Основной Border с закруглением -->
                                    <Border x:Name="PART_Indicator"
                                            CornerRadius="8"
                                            Background="{TemplateBinding Foreground}"
                                            HorizontalAlignment="Left"
                                            Width="{Binding ElementName=PART_Track, Path=ActualWidth}"/>
                                </Grid>
                            </Border>

                            <!-- Текст прогресса (опционально) -->
                            <TextBlock x:Name="ProgressText"
                                       Text="{Binding Value, 
                                              RelativeSource={RelativeSource TemplatedParent}, 
                                              StringFormat={}{0:0}%}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Visibility="Collapsed"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Показывать текст только если значение > 0 -->
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="ProgressText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Value" Value="100">
                                <Setter TargetName="ProgressText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConnectionProgressStyle"
               TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0 4 0 0"/>
        </Style>
        <Style x:Key="MigrationStatusStyle"
               TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0 4 0 0"/>
        </Style>
        <Style x:Key="ProgressMessageStyle"
               TargetType="Label">
            <Setter Property="Margin" Value="0 4 0 0"/>
        </Style>
        <SolidColorBrush x:Key="ProgressBar.Progress" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="ProgressBar.Background" Color="{StaticResource BgProgressColor}"/>
        <SolidColorBrush x:Key="ProgressBar.Border" Color="{StaticResource BorderColorColor}"/>
        <Style x:Key="RoundedProgressBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource ProgressBar.Progress}"/>
            <Setter Property="Background" Value="{StaticResource ProgressBar.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ProgressBar.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid x:Name="TemplateRoot">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Determinate"/>
                                    <VisualState x:Name="Indeterminate">
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Анимируем ScaleX -->
                                            <DoubleAnimationUsingKeyFrames 
                                                Storyboard.TargetName="MyScale" 
                                                Storyboard.TargetProperty="ScaleX">
                                                <EasingDoubleKeyFrame KeyTime="0" Value="0.25"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0.25"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0.25"/>
                                            </DoubleAnimationUsingKeyFrames>

                                            <!-- Анимируем центр масштабирования CenterX -->
                                            <DoubleAnimationUsingKeyFrames 
                                                Storyboard.TargetName="MyScale" 
                                                Storyboard.TargetProperty="CenterX">
                                                <EasingDoubleKeyFrame KeyTime="0" Value="-216"/>
                                                <!-- -0.5 от ширины 100 -->
                                                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="216"/>
                                                <!-- 0.5 от ширины 100 -->
                                                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="-216"/>
                                                <!-- 1.5 от ширины 100 -->
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"/>
                            <Rectangle x:Name="PART_Track"/>
                            <Grid x:Name="PART_Indicator" ClipToBounds="true" HorizontalAlignment="Left">
                                <Rectangle x:Name="Indicator" Fill="{TemplateBinding Foreground}"/>
                                <Border x:Name="Animation" 
                                        Background="{TemplateBinding Foreground}" 
                                        RenderTransformOrigin="0.5,0.5"
                                        CornerRadius="30">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <!-- Центр масштабирования теперь управляется через CenterX -->
                                            <ScaleTransform x:Name="MyScale" ScaleX="0.25" CenterX="0" CenterY="0.5"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="LayoutTransform" TargetName="TemplateRoot">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsIndeterminate" Value="true">
                                <Setter Property="Visibility" TargetName="Indicator" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource MainBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0" 
                         Minimum="{Binding Min}" 
                         Maximum="{Binding Max}" 
                         Value="{Binding Value}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Style="{DynamicResource RoundedProgressBarStyle}"/>
            <Label Grid.Row="1"
                   Content="{Binding ConnectionProgress, FallbackValue='Проверка подключения...'}"
                   Style="{StaticResource ConnectionProgressStyle}"/>
            <Label Grid.Row="2"
                   Content="{Binding MigrationStatus, FallbackValue='Инициализация завершена! БД готова к работе.'}"
                   Style="{StaticResource MigrationStatusStyle}"/>
            <Grid Grid.Row="3"
                  Margin="0 4 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"
                       Content="📊 Найдено записей: "
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"/>
                <Label Grid.Column="1"
                       Content="{Binding TotalRecords, FallbackValue='0'}"
                       FontSize="13"
                       Foreground="{StaticResource Accent}"/>
            </Grid>
            <Label Grid.Row="4"
                   Content="{Binding ProgressMessage, FallbackValue='Данные отсутствуют⚡ Рекомендуется наполнить тестовыми данными'}"
                   Style="{StaticResource ProgressMessageStyle}"/>
        </Grid>
    </Border>
</UserControl>
