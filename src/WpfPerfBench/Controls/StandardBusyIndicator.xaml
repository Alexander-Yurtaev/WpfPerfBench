<UserControl x:Class="WpfPerfBench.Controls.StandardBusyIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <local:BusySpinner Grid.Row="0"
                               Width="72"
                               Height="72"
                               Margin="0 0 0 20"/>

            <TextBlock Grid.Row="1" 
                       Text="Загрузка..."
                       Foreground="{DynamicResource BusyText}"
                       FontSize="16"
                       FontWeight="Medium"
                       Margin="0 0 0 20"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock Grid.Row="2" 
                       Text="Пожалуйста, подождите"
                       Margin="0 0 0 20"
                       Foreground="{DynamicResource BusySubText}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>