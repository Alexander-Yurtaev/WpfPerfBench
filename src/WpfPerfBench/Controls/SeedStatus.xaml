<UserControl x:Class="WpfPerfBench.Controls.SeedStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Controls"
             xmlns:converters="clr-namespace:WpfPerfBench.Converters"
             xmlns:enum="clr-namespace:WpfPerfBench.Enums"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConv"/>
        <Style x:Key="SeedStatusBorderStyle"
               TargetType="Border">
            <Setter Property="Padding" Value="12 4"/>
            <Setter Property="CornerRadius" Value="30"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" 
                             Value="{x:Static enum:SeedStatus.None}">
                    <Setter Property="Background" Value="{DynamicResource Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" 
                             Value="{x:Static enum:SeedStatus.Processing}">
                    <Setter Property="Background" Value="{DynamicResource Danger}"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Анимация прозрачности для эффекта пульсации -->
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="Opacity"
                                    From="1.0" 
                                    To="0.5" 
                                    Duration="0:0:0.5" 
                                    AutoReverse="True" 
                                    RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="Opacity"
                                    To="1.0" 
                                    Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" 
                             Value="{x:Static enum:SeedStatus.Finished}">
                    <Setter Property="Background" Value="{DynamicResource BgInput}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" 
                             Value="{x:Static enum:SeedStatus.Failed}">
                    <Setter Property="Background" Value="{DynamicResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" 
                             Value="{x:Static enum:SeedStatus.Canceled}">
                    <Setter Property="Background" Value="{DynamicResource TextMute}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeedStatusTextBlockStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" 
                             Value="{x:Static enum:SeedStatus.None}">
                    <Setter Property="Foreground" Value="{DynamicResource TextInverse}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" 
                             Value="{x:Static enum:SeedStatus.Processing}">
                    <Setter Property="Foreground" Value="{DynamicResource TextInverse}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" 
                             Value="{x:Static enum:SeedStatus.Finished}">
                    <Setter Property="Foreground" Value="{DynamicResource TextMute}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" 
                             Value="{x:Static enum:SeedStatus.Failed}">
                    <Setter Property="Foreground" Value="{DynamicResource TextInverse}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" 
                             Value="{x:Static enum:SeedStatus.Canceled}">
                    <Setter Property="Foreground" Value="{DynamicResource BgInput}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border HorizontalAlignment="Center"
            Style="{StaticResource SeedStatusBorderStyle}">
        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConv}}"
                   FontSize="12"
                   FontWeight="Medium"
                   Style="{StaticResource SeedStatusTextBlockStyle}"/>
    </Border>
</UserControl>
