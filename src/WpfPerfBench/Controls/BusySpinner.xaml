<!-- BusySpinner.xaml -->
<UserControl x:Class="WpfPerfBench.Controls.BusySpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Controls"
             mc:Ignorable="d">

    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Width="72" Height="72">
            <Grid.Resources>
                <Storyboard x:Key="SpinOuter" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="OuterRotate" 
                                     Storyboard.TargetProperty="Angle" 
                                     From="0" To="360" 
                                     Duration="0:0:1"/>
                </Storyboard>
                <Storyboard x:Key="SpinInner" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="InnerRotate" 
                                     Storyboard.TargetProperty="Angle" 
                                     From="360" To="0" 
                                     Duration="0:0:1.2"/>
                </Storyboard>
                <Storyboard x:Key="PulseDot" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="DotScale" 
                                     Storyboard.TargetProperty="ScaleX" 
                                     From="0" To="1" 
                                     Duration="0:0:0.75" 
                                     AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="DotScale" 
                                     Storyboard.TargetProperty="ScaleY" 
                                     From="0" To="1" 
                                     Duration="0:0:0.75" 
                                     AutoReverse="True"/>
                </Storyboard>
            </Grid.Resources>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource SpinOuter}"/>
                    <BeginStoryboard Storyboard="{StaticResource SpinInner}"/>
                    <BeginStoryboard Storyboard="{StaticResource PulseDot}"/>
                </EventTrigger>
            </Grid.Triggers>

            <!-- Внешнее кольцо -->
            <Border Width="72" 
                    Height="72" 
                    CornerRadius="36" 
                    BorderThickness="4">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="Transparent"/>
                        <GradientStop Offset="0.3" Color="Transparent"/>
                        <GradientStop Offset="0.7" Color="{DynamicResource BusyCircleOuterColor}"/>
                        <GradientStop Offset="1" Color="{DynamicResource BusyCircleOuterColor}"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.RenderTransform>
                    <RotateTransform x:Name="OuterRotate" 
                                     CenterX="36" 
                                     CenterY="36"/>
                </Border.RenderTransform>
            </Border>

            <!-- Внутреннее кольцо -->
            <Border Width="44" 
                    Height="44" 
                    CornerRadius="22" 
                    BorderThickness="4"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="Transparent"/>
                        <GradientStop Offset="0.3" Color="Transparent"/>
                        <GradientStop Offset="0.7" Color="{DynamicResource BusyCircleInnerColor}"/>
                        <GradientStop Offset="1" Color="{DynamicResource BusyCircleInnerColor}"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.RenderTransform>
                    <RotateTransform x:Name="InnerRotate" 
                                     CenterX="22" 
                                     CenterY="22"/>
                </Border.RenderTransform>
            </Border>

            <!-- Точка -->
            <Ellipse Width="10" 
                     Height="10" 
                     Fill="{DynamicResource BusyDot}"
                     VerticalAlignment="Center" 
                     HorizontalAlignment="Center">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="DotScale" 
                                    CenterX="5" 
                                    CenterY="5"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
    </Viewbox>
</UserControl>