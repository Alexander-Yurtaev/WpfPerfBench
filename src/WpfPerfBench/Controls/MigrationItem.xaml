<UserControl x:Class="WpfPerfBench.Controls.MigrationItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Controls"
             xmlns:converters="clr-namespace:WpfPerfBench.Converters"
             xmlns:data="clr-namespace:WpfPerfBench.Data"
             xmlns:enum="clr-namespace:WpfPerfBench.Core.Enum;assembly=WpfPerfBench.Core"
             mc:Ignorable="d" 
             d:DesignWidth="800">

    <UserControl.Resources>
        <converters:StatusToImageConverter x:Key="StatusToImageConv"
                                           PendingIcon="pack://application:,,,/Resources/Icons/pending.png"
                                           SuccessIcon="pack://application:,,,/Resources/Icons/success.png"
                                           FailIcon="pack://application:,,,/Resources/Icons/cross_mark.png"
                                           SkippedIcon="pack://application:,,,/Resources/Icons/skipped.png"
                                           ProcessingIcon="pack://application:,,,/Resources/Icons/processing.png"/>
        
        <DataTemplate DataType="{x:Type enum:MigrationStatus}">
            <local:MigrationStatus/>
        </DataTemplate>
    </UserControl.Resources>

    <Border HorizontalAlignment="Stretch"
            Padding="16 12"
            Background="{DynamicResource BgSecondary}"
            CornerRadius="8"
            BorderThickness="0 0 4 0"
            BorderBrush="{DynamicResource BorderColor}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Width="18"
                   Height="18"
                   Margin="0 0 12 0"
                   Source="{Binding Status, Converter={StaticResource StatusToImageConv}}"/>
            <TextBlock Grid.Column="1"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="14"
                       FontWeight="Medium"
                       Margin="0 0 12 0"
                       Text="{Binding Name}"/>
            <ContentControl Grid.Column="2"
                            Content="{Binding Status}"/>
        </Grid>
    </Border>
</UserControl>
