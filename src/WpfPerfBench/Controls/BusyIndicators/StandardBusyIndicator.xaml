<UserControl x:Class="WpfPerfBench.Controls.BusyIndicators.StandardBusyIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Border>
        <Grid VerticalAlignment="Center"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <local:BusySpinner Grid.Row="0"
                               Width="96"
                               Height="96"
                               Margin="0 0 0 24"/>

            <TextBlock Grid.Row="1" 
                       Text="{Binding BusyText, FallbackValue='Загрузка...'}"
                       Foreground="{DynamicResource BusyText}"
                       FontSize="22"
                       FontWeight="Medium"
                       Margin="0 0 0 24"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock Grid.Row="2" 
                       Text="{Binding BusySubText, FallbackValue='Пожалуйста, подождите'}"
                       Margin="0 0 0 24"
                       Foreground="{DynamicResource BusySubText}"
                       FontSize="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <Button Grid.Row="3" 
                    Content="✕ Отмена"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource BtnBusyCloseStyle}"/>
        </Grid>
    </Border>
</UserControl>