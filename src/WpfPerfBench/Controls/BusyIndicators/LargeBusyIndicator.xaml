<UserControl x:Class="WpfPerfBench.Controls.BusyIndicators.LargeBusyIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Controls"
             xmlns:designViewModels="clr-namespace:WpfPerfBench.DesignViewModels"
             xmlns:busyIndicators="clr-namespace:WpfPerfBench.DesignViewModels.BusyIndicators"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=busyIndicators:DesignLargeBusyIndicator, IsDesignTimeCreatable=True}">

    <Border>
        <Grid VerticalAlignment="Center"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <local:BusySpinner Grid.Row="0"
                               Width="96"
                               Height="96"
                               Margin="0 0 0 24"/>

            <TextBlock Grid.Row="1" 
                       Text="{Binding BusyText, FallbackValue='Загрузка...'}"
                       Foreground="{DynamicResource BusyText}"
                       FontSize="22"
                       FontWeight="Medium"
                       Margin="0 0 0 24"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock Grid.Row="2" 
                       Text="{Binding BusySubText, FallbackValue='Загружено 0 / 0 элементов'}"
                       Margin="0 0 0 24"
                       Foreground="{DynamicResource BusySubText}"
                       FontSize="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="3"
                        Orientation="Vertical"
                        Margin="0 0 0 24"
                        Width="280">

                <ProgressBar Minimum="0"
                             Maximum="{Binding Maximum, FallbackValue=100}"
                             Value="{Binding Value, FallbackValue=0}"
                             Style="{StaticResource BusyProgressBarStyle}"/>

                <TextBlock Foreground="{DynamicResource TextSecondary}"
                           FontSize="14"
                           Margin="0 8 0 0"
                           TextAlignment="Center"
                           Text="{Binding Percent, FallbackValue=0%, StringFormat={}{0:P0}, Mode=OneWay}"/>
            </StackPanel>

            <Button Grid.Row="5" 
                    Content="✕ Отмена"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource BtnBusyCloseStyle}"/>
        </Grid>
    </Border>
</UserControl>
