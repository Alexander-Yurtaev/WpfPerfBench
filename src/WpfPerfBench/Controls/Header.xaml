<UserControl x:Class="WpfPerfBench.Controls.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Controls"
             mc:Ignorable="d" 
             d:DesignWidth="350">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="400"/>
        </Style>
        <Style TargetType="Border">
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="7"/>
        </Style>
        <Style x:Key="BtnCloseStyle"
               TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Margin" Value="2 0"/>
        </Style>
    </UserControl.Resources>

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding RelativeSource={RelativeSource AncestorType=local:Header, Mode=FindAncestor}, Path=Icon}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding RelativeSource={RelativeSource AncestorType=local:Header, Mode=FindAncestor}, Path=Title}"/>
            <local:Pager Grid.Column="2"
                         CurrentStep="{Binding RelativeSource={RelativeSource AncestorType=local:Header, Mode=FindAncestor}, Path=CurrentStep}"
                         TotalSteps="{Binding RelativeSource={RelativeSource AncestorType=local:Header, Mode=FindAncestor}, Path=TotalSteps}"/>
            <Button Grid.Column="3" 
                    VerticalAlignment="Center"
                    Content="✕" 
                    Command="ApplicationCommands.Close"
                    Style="{StaticResource BtnCloseStyle}"/>
        </Grid>
    </Border>
</UserControl>
