<UserControl x:Class="WpfPerfBench.Controls.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Controls"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="350">

    <UserControl.Resources>
        <Style TargetType="Image">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Margin" Value="0 0 6 0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </UserControl.Resources>

    <Border>
        <Grid>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Border Grid.Column="1"
                        BorderThickness="0 0 0 2"
                        BorderBrush="{DynamicResource Accent}"
                        Margin=" 0 0 0 5"
                        Padding="0 0 0 3"
                        HorizontalAlignment="Right">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0"
                               Source="{Binding IconPath}"/>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding Title}"/>
                    </Grid>
                </Border>
                <local:ThemeSwitcher Grid.Column="2"
                                     VerticalAlignment="Center"
                                     Margin="25 0"
                                     DataContext="{Binding ThemeManager}"/>
            </StackPanel>
            
            <Button VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Content="✕" 
                    Command="ApplicationCommands.Close"
                    Style="{StaticResource BtnCloseStyle}"/>
        </Grid>
    </Border>
</UserControl>
