<UserControl x:Class="WpfPerfBench.Controls.ProgressBusyIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border>
        <Grid VerticalAlignment="Center"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <local:BusySpinner Grid.Row="0"
                               Width="96"
                               Height="96"
                               Margin="0 0 0 24"/>

            <TextBlock Grid.Row="1" 
                       Text="{Binding BusyText, RelativeSource={RelativeSource AncestorType=local:BusyIndicator}, FallbackValue='Загрузка...'}"
                       Foreground="{DynamicResource BusyText}"
                       FontSize="22"
                       FontWeight="Medium"
                       Margin="0 0 0 24"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock Grid.Row="2" 
                       Text="{Binding BusySubText, RelativeSource={RelativeSource AncestorType=local:BusyIndicator}, FallbackValue='Пожалуйста, подождите'}"
                       Margin="0 0 0 24"
                       Foreground="{DynamicResource BusySubText}"
                       FontSize="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="3"
                        Orientation="Vertical"
                        Margin="0 0 0 24"
                        Width="280">

                <ProgressBar Grid.Row="3"
                             Minimum="{Binding Minimum, RelativeSource={RelativeSource AncestorType=local:BusyIndicator}, FallbackValue=0}"
                             Maximum="{Binding Maximum, RelativeSource={RelativeSource AncestorType=local:BusyIndicator}, FallbackValue=100}"
                             Value="{Binding Value, RelativeSource={RelativeSource AncestorType=local:BusyIndicator}, FallbackValue=0}"
                             Style="{StaticResource BusyProgressBarStyle}"/>

                <TextBlock Grid.Row="4"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="14"
                           Margin="0 8 0 0"
                           TextAlignment="Center"
                           Text="{Binding Percent, RelativeSource={RelativeSource AncestorType=local:BusyIndicator}, FallbackValue=0%, StringFormat={}{0:P0}, Mode=OneWay}"/>
            </StackPanel>
            
            <Button Grid.Row="5" 
                    Content="✕ Отмена"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Command="{Binding CancelCommand, RelativeSource={RelativeSource AncestorType=local:BusyIndicator}}"
                    Style="{StaticResource BtnBusyCloseStyle}"/>
        </Grid>
    </Border>
</UserControl>
