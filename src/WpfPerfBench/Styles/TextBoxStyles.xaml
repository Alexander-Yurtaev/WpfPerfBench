<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ShadowTextBoxStyle"
               TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5 7"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>

        <!-- Отключаем стандартную рамку -->
        <Setter Property="BorderThickness" Value="0"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- Основной Border с радиусом и тенью -->
                    <Border x:Name="Bd"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2">

                        <!-- Тень применяем именно сюда -->
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" 
                                                  ShadowDepth="0"
                                                  Color="{TemplateBinding BorderBrush}" 
                                                  Opacity="0.3"/>
                        </Border.Effect>

                        <!-- ScrollViewer нужен для длинного текста -->
                        <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>

                    </Border>

                    <!-- Триггеры для состояния ошибки и фокуса -->
                    <ControlTemplate.Triggers>
                        <!--<Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#89B4FA"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                            </Trigger>-->

                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Danger}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                            <!--<Setter Property="ToolTip" 
                                        Value="{Binding RelativeSource={RelativeSource Self},
                                                                Path=(Validation.Errors)[0].ErrorContent}"/>-->
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6" 
                                                          ShadowDepth="0" 
                                                          Color="{DynamicResource DangerColor}" 
                                                          Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!--<Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A6ADB8"/>
                            </Trigger>-->
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource ShadowTextBoxStyle}">
        <Setter Property="Background" Value="{DynamicResource BgInput}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Success}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding NavigationService.CurrentPage}" Value="Init">
                <Setter Property="IsReadOnly" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>