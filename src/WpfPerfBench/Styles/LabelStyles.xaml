<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FormLabelStyle"
           TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0 0 0 5"/>
    </Style>

    <Style x:Key="FioValidationStyle"
           TargetType="Label">
        <Setter Property="DataContext" Value="{Binding ElementName=FioTextBox,
                                                               Path=(Validation.Errors).CurrentItem}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=FioTextBox}" 
                         Value="False">
                <Setter Property="Content">
                    <Setter.Value>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Resources/Icons/success.png"
                                   Style="{StaticResource ValidationImageStyle}"/>
                            <Label  Content="Поле заполнено"
                                    Foreground="{DynamicResource Success}"/>
                        </StackPanel>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=FioTextBox}" 
                         Value="True">
                <Setter Property="Content">
                    <Setter.Value>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Resources/Icons/cross_mark.png"
                                   Style="{StaticResource ValidationImageStyle}"/>
                            <Label  Content="{Binding ErrorContent}"
                                    Foreground="{DynamicResource Danger}"/>
                        </StackPanel>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

