<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FormLabelStyle"
           TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0 0 0 5"/>
    </Style>

    <Style x:Key="FioValidationStyle"
           TargetType="Label">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=FioTextBox}" 
                         Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                <Setter Property="Content" Value="✅ Поле заполнено"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=FioTextBox}" 
                         Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                <Setter Property="Content" Value="{Binding ElementName=FioTextBox,
                                                               Path=(Validation.Errors).CurrentItem.ErrorContent}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

