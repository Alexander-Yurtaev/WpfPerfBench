<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:WpfPerfBench"
                    xmlns:controls="clr-namespace:WpfPerfBench.Controls">

    <Style TargetType="{x:Type controls:BusyIndicator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BusyIndicator}">
                    <Grid x:Name="PART_Root">
                        <!-- Основной контент -->
                        <ContentPresenter x:Name="PART_ContentPresenter" />

                        <!-- Оверлей с индикатором -->
                        <Grid x:Name="PART_Overlay" 
                              Visibility="Collapsed" 
                              Background="{DynamicResource BgBusyOverlay}">

                            <controls:StandardBusyIndicator x:Name="PART_StandardBusyIndicator" 
                                                            Visibility="Collapsed"/>
                            <controls:ProgressBusyIndicator x:Name="PART_ProgressBusyIndicator" 
                                                            Visibility="Collapsed"/>
                            <controls:LargeBusyIndicator x:Name="PART_LargeBusyIndicator" 
                                                         Visibility="Collapsed"/>
                            <controls:CompactBusyIndicator x:Name="PART_CompactBusyIndicator" 
                                                           Visibility="Collapsed"/>
                        </Grid>
                    </Grid>

                    <!-- Триггеры видимости оверлея -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsBusy" Value="True">
                            <Setter TargetName="PART_Overlay" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsBusy" Value="False">
                            <Setter TargetName="PART_Overlay" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <Trigger Property="BusyType" Value="Standard">
                            <Setter TargetName="PART_StandardBusyIndicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="BusyType" Value="Progress">
                            <Setter TargetName="PART_ProgressBusyIndicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="BusyType" Value="Large">
                            <Setter TargetName="PART_LargeBusyIndicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="BusyType" Value="Compact">
                            <Setter TargetName="PART_CompactBusyIndicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StandardBusyOverlay"
           TargetType="Grid">
    </Style>
</ResourceDictionary>