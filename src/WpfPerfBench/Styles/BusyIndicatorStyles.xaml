<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:WpfPerfBench"
                    xmlns:controls="clr-namespace:WpfPerfBench.Controls">

    <Style TargetType="{x:Type controls:BusyIndicator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BusyIndicator}">
                    <Grid x:Name="PART_Root">
                        <!-- Основной контент -->
                        <ContentPresenter x:Name="PART_ContentPresenter" />

                        <!-- Оверлей с индикатором -->
                        <Grid x:Name="PART_Overlay" 
                              Visibility="Collapsed" 
                              Background="{DynamicResource BgBusyOverlay}">

                            <ContentControl Content="{TemplateBinding ContentIndicator}"/>

                        </Grid>
                    </Grid>

                    <!-- Триггеры видимости оверлея -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsBusy" Value="True">
                            <Setter TargetName="PART_Overlay" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsBusy" Value="False">
                            <Setter TargetName="PART_Overlay" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StandardBusyOverlay"
           TargetType="Grid">
    </Style>

    <DataTemplate DataType="{x:Type controls:StandardContentIndicator}">
        <controls:StandardBusyIndicator/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type controls:ProgressContentIndicator}">
        <controls:ProgressBusyIndicator/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type controls:LargeContentIndicator}">
        <controls:LargeBusyIndicator/>
    </DataTemplate>

</ResourceDictionary>