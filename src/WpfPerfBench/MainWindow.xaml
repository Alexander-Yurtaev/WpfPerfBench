<Window x:Class="WpfPerfBench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfPerfBench"
        xmlns:controls="clr-namespace:WpfPerfBench.Controls"
        xmlns:behaviors="clr-namespace:WpfPerfBench.Behaviors"
        mc:Ignorable="d"
        Title="WPF Performance Demo" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Height="916" Width="612">

    <b:Interaction.Behaviors>
        <behaviors:DragMoveBehavior/>
    </b:Interaction.Behaviors>

    <Grid>
        <controls:MainControl />
    </Grid>
</Window>
