<UserControl x:Class="WpfPerfBench.Views.InitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Views"
             xmlns:controls="clr-namespace:WpfPerfBench.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="UserControl">
            <Setter Property="Background" Value="{StaticResource BgWindow}"/>
        </Style>
        <Style x:Key="HeaderGridStyle"
               TargetType="Grid">
            <Setter Property="Margin" Value="0 0 0 25"/>
        </Style>
        <Style x:Key="HeaderIconStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Light"/>
        </Style>
        <Style x:Key="HeaderTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="FormGroupStyle"
               TargetType="Grid">
            <Setter Property="Margin" Value="0 0 0 18"/>
        </Style>
        <Style x:Key="FormLabelStyle"
               TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0 0 0 5"/>
        </Style>
        <Style x:Key="FormTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource ShadowTextBoxStyle}">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style x:Key="FioValidationStyle"
               TargetType="Label">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=FioTextBox}" 
                             Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                    <Setter Property="Content" Value="✅ Поле заполнено"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=FioTextBox}" 
                             Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    <Setter Property="Content" Value="{Binding ElementName=FioTextBox,
                                                               Path=(Validation.Errors).CurrentItem.ErrorContent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EmailValidationStyle"
               TargetType="Label">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=EmailTextBox}" 
                             Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                    <Setter Property="Content" Value="✅ Корректный формат"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=EmailTextBox}" 
                             Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    <Setter Property="Content" Value="{Binding ElementName=EmailTextBox,
                                                               Path=(Validation.Errors).CurrentItem.ErrorContent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PasswordValidationStyle"
               TargetType="Label">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=PasswordTextBox}" 
                             Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                    <Setter Property="Content" Value="✅ Пароль корректный"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=PasswordTextBox}" 
                             Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    <Setter Property="Content" Value="{Binding ElementName=PasswordTextBox,
                                                               Path=(Validation.Errors).CurrentItem.ErrorContent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ConfirmPasswordValidationStyle"
               TargetType="Label">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=ConfirmPasswordTextBox}" 
                             Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                    <Setter Property="Content" Value="✅ Пароли совпадают"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=ConfirmPasswordTextBox}" 
                             Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    <Setter Property="Content" Value="{Binding ElementName=ConfirmPasswordTextBox,
                                                               Path=(Validation.Errors).CurrentItem.ErrorContent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ConnectionStringValidationStyle"
               TargetType="Label">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=ConnectionStringTextBox}" 
                             Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                    <Setter Property="Content" Value="✅ Поле заполнено"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=ConnectionStringTextBox}" 
                             Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    <Setter Property="Content" Value="{Binding ElementName=ConnectionStringTextBox,
                                                               Path=(Validation.Errors).CurrentItem.ErrorContent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="14 10"/>
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="BorderValidationStatusStyle"
               TargetType="Border">
            <Setter Property="Margin" Value="0 12 0 0"/>
            <Setter Property="Padding" Value="0 12 0 0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0 1 0 0"/>
        </Style>
        <Style x:Key="ValidationStatusStyle"
               TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Success}"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=HasErrors}" Value="False">
                    <Setter Property="Content" Value="✅ Все поля валидны"/>
                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=HasErrors}" Value="True">
                    <Setter Property="Content" Value="❌ Некоторые поля заполнены некорректно • Исправьте ошибки"/>
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Style="{StaticResource HeaderIconStyle}"
                       Text="⚙️"/>
            <TextBlock Grid.Column="1"
                       Style="{StaticResource HeaderTextStyle}"
                       Text="Настройка подключения"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Style="{StaticResource FormGroupStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" 
                       Content="👤 ФИО *"
                       Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="1"
                         x:Name="FioTextBox"
                         Text="{Binding Fio, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"/>
                <Label Grid.Row="2" 
                           Style="{StaticResource FioValidationStyle}"/>
            </Grid>
            <Grid Grid.Row="1"
                  Style="{StaticResource FormGroupStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" 
                       Content="📧 Email *"
                       Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="1"
                         x:Name="EmailTextBox"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"/>
                <Label Grid.Row="2"
                       Style="{StaticResource EmailValidationStyle}"/>
            </Grid>
            <Grid Grid.Row="2"
                  Style="{StaticResource FormGroupStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                      Margin="0 0 7.5 0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" 
                           Content="🔒 Пароль *"
                           Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="1"
                             x:Name="PasswordTextBox"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"/>
                    <Label Grid.Row="2" 
                           Style="{StaticResource PasswordValidationStyle}"/>
                </Grid>
                <Grid Grid.Column="1"
                      Margin="7.5 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" 
                           Content="🔐 Подтверждение пароля *"
                           Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="1"
                             x:Name="ConfirmPasswordTextBox"
                             Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"/>
                    <Label Grid.Row="2" 
                           Style="{StaticResource ConfirmPasswordValidationStyle}"/>
                </Grid>
            </Grid>
            <Grid Grid.Row="3"
                  Style="{StaticResource FormGroupStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                      Margin="0 0 7.5 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" 
                           Content="🗄️ Тип базы данных"
                           Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox Grid.Row="1"
                              ItemsSource="{Binding DbTypes}"
                              SelectedValue="{Binding DbType, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource RoundedComboBoxStyle}"/>
                    <Label Grid.Row="2" Content="🗄️ Тип базы данных" Visibility="Hidden"/>
                </Grid>
                <Grid Grid.Column="1"
                      Margin="7.5 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" 
                           Content="🔗 Connection String"
                           Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="1"
                             x:Name="ConnectionStringTextBox"
                             Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"/>
                    <Label Grid.Row="2" 
                           Style="{StaticResource ConnectionStringValidationStyle}"/>
                </Grid>
            </Grid>
            <Grid Grid.Row="4"
                  Style="{StaticResource FormGroupStyle}">
                <controls:InitProgressStand/>
            </Grid>
            <Grid Grid.Row="5"
                  Style="{StaticResource FormGroupStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" 
                        Content="Тест"
                        Style="{StaticResource SecondaryBtnStyle}"/>
                <Button Grid.Column="2" 
                        Content="Миграция"
                        Style="{StaticResource SecondaryBtnStyle}"/>
                <Button Grid.Column="3" 
                        Content="Далее"
                        IsDefault="True"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=local:InitView},
                                                Path=NextCommand}"
                        Style="{StaticResource PrimaryBtnStyle}"/>
            </Grid>
        </Grid>
        <Border Grid.Row="2"
                Style="{StaticResource BorderValidationStatusStyle}">
            <Label Style="{StaticResource ValidationStatusStyle}"/>
        </Border>
    </Grid>
</UserControl>
