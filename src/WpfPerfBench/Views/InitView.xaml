<UserControl x:Class="WpfPerfBench.Views.InitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Views"
             xmlns:controls="clr-namespace:WpfPerfBench.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="811.43" d:DesignWidth="504">

    <UserControl.Resources>
        <Style x:Key="InitProgressStandStyle"
               TargetType="controls:InitProgressStand">
            <Setter Property="Visibility" Value="Visible"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Style="{StaticResource HeaderIconStyle}"
                       Text="⚙️"/>
            <TextBlock Grid.Column="1"
                       Style="{StaticResource HeaderTextStyle}"
                       Text="Настройка подключения"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Style="{StaticResource FormGroupStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" 
                       Content="👤 ФИО *"
                       Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="1"
                         x:Name="FioTextBox"
                         Text="{Binding Fio, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"/>
                <Label Grid.Row="2" 
                           Style="{StaticResource FioValidationStyle}"/>
            </Grid>
            <Grid Grid.Row="1"
                  Style="{StaticResource FormGroupStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" 
                       Content="📧 Email *"
                       Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="1"
                         x:Name="EmailTextBox"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"/>
                <Label Grid.Row="2"
                       Style="{StaticResource EmailValidationStyle}"/>
            </Grid>
            <Grid Grid.Row="2"
                  Style="{StaticResource FormGroupStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                      Margin="0 0 7.5 0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" 
                           Content="🔒 Пароль *"
                           Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="1"
                             x:Name="PasswordTextBox"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"/>
                    <Label Grid.Row="2" 
                           Style="{StaticResource PasswordValidationStyle}"/>
                </Grid>
                <Grid Grid.Column="1"
                      Margin="7.5 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" 
                           Content="🔐 Подтверждение пароля *"
                           Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="1"
                             x:Name="ConfirmPasswordTextBox"
                             Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"/>
                    <Label Grid.Row="2" 
                           Style="{StaticResource ConfirmPasswordValidationStyle}"/>
                </Grid>
            </Grid>
            <Grid Grid.Row="3"
                  Style="{StaticResource FormGroupStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                      Margin="0 0 7.5 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" 
                           Content="🗄️ Тип базы данных"
                           Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox Grid.Row="1"
                              ItemsSource="{Binding DbTypes}"
                              SelectedValue="{Binding DbType, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource FormComboBoxStyle}"/>
                    <Label Grid.Row="2" Content="🗄️ Тип базы данных" Visibility="Hidden"/>
                </Grid>
                <Grid Grid.Column="1"
                      Margin="7.5 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" 
                           Content="🔗 Connection String"
                           Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="1"
                             x:Name="ConnectionStringTextBox"
                             Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"/>
                    <Label Grid.Row="2" 
                           Style="{StaticResource ConnectionStringValidationStyle}"/>
                </Grid>
            </Grid>
            <Grid Grid.Row="4"
                  Style="{StaticResource FormGroupStyle}">
                <controls:InitProgressStand 
                            DataContext="{Binding InitProgressStand}"
                            Style="{StaticResource InitProgressStandStyle}"/>
            </Grid>
            <Grid Grid.Row="5"
                  Style="{StaticResource FormGroupStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" 
                        Content="Тест"
                        Command="{Binding TestCommand}"
                        Style="{StaticResource SecondaryBtnStyle}"/>
                <Button Grid.Column="2" 
                        Content="Миграция"
                        Command="{Binding MigrateCommand}"
                        Style="{StaticResource SecondaryBtnStyle}"/>
                <Button Grid.Column="3" 
                        Content="Далее"
                        Command="{Binding NextCommand}"
                        Style="{StaticResource SecondaryBtnStyle}"/>
            </Grid>
        </Grid>
        <Border Grid.Row="2"
                Style="{StaticResource BorderValidationStatusStyle}">
            <Label Content="{Binding ValidationStatus}"
                   Style="{StaticResource ValidationStatusStyle}"/>
        </Border>
    </Grid>
</UserControl>
