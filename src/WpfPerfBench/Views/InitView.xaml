<UserControl x:Class="WpfPerfBench.Views.InitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Views"
             xmlns:behaviors="clr-namespace:WpfPerfBench.Behaviors"
             xmlns:designViewModels="clr-namespace:WpfPerfBench.DesignViewModels"
             mc:Ignorable="d" 
             d:DesignWidth="950" d:DesignHeight="791.38"
             d:DataContext="{d:DesignInstance Type=designViewModels:DesignInitViewModel, IsDesignTimeCreatable=True}">

    <Border Style="{DynamicResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Style="{StaticResource HeaderGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Source="pack://application:,,,/WpfPerfBench;component/Resources/Icons/geer.png" 
                       Style="{StaticResource HeaderIconStyle}" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource HeaderTextStyle}"
                           Text="Настройка подключения"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                  Style="{StaticResource FormGroupStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal">
                        <Image Source="pack://application:,,,/WpfPerfBench;component/Resources/Icons/man.png"
                               Style="{StaticResource FormImageStyle}"/>
                        <Label Content="ФИО *"
                               Style="{StaticResource FormLabelStyle}"/>
                    </StackPanel>
                    <TextBox Grid.Row="1"
                             x:Name="FioTextBox"
                             behaviors:FocusOnLoad.IsActive="True"
                             Text="{Binding Fio, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"/>
                    <Label Grid.Row="2" 
                           Style="{StaticResource FioValidationStyle}"/>
                </Grid>
                <Grid Grid.Row="1"
                  Style="{StaticResource FormGroupStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal">
                        <Image Source="pack://application:,,,/WpfPerfBench;component/Resources/Icons/email.png"
                               Style="{StaticResource FormImageStyle}"/>
                        <Label Content="Email *"
                               Style="{StaticResource FormLabelStyle}"/>
                    </StackPanel>
                    <TextBox Grid.Row="1"
                             x:Name="EmailTextBox"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"/>
                    <Label  Grid.Row="2"
                            Style="{StaticResource EmailValidationStyle}"/>
                </Grid>
                <Grid Grid.Row="2"
                      Style="{StaticResource FormGroupStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Column="0" 
                                Grid.Row="0"
                                Orientation="Horizontal">
                        <Image Source="pack://application:,,,/WpfPerfBench;component/Resources/Icons/lock.png"
                               Style="{StaticResource FormImageStyle}"/>
                        <Label Content="Пароль *"
                                   Style="{StaticResource FormLabelStyle}"/>
                    </StackPanel>
                    <PasswordBox Grid.Column="0" 
                                 Grid.Row="1"
                                 x:Name="PasswordBox"
                                 behaviors:PasswordBoxBehavior.PropertyName="Password"
                                 Tag="{Binding Password, Mode=OneWay}"
                                 Style="{StaticResource FormPasswordBoxStyle}"/>
                    <Label Grid.Column="0" 
                           Grid.Row="2" 
                           Style="{StaticResource PasswordValidationStyle}"/>

                    <StackPanel Grid.Column="2" 
                                Grid.Row="0"
                                Orientation="Horizontal">
                        <Image Source="pack://application:,,,/WpfPerfBench;component/Resources/Icons/key_lock.png"
                               Style="{StaticResource FormImageStyle}"/>
                        <Label Content="Подтверждение пароля *"
                                   Style="{StaticResource FormLabelStyle}"/>
                    </StackPanel>
                    <PasswordBox Grid.Column="2"
                                 Grid.Row="1"
                                 x:Name="ConfirmPasswordBox"
                                 behaviors:PasswordBoxBehavior.PropertyName="ConfirmPassword"
                                 Tag="{Binding ConfirmPassword, Mode=OneWay}"
                                 Style="{StaticResource FormPasswordBoxStyle}"/>
                    <Label  Grid.Column="2" 
                            Grid.Row="2" 
                            Style="{StaticResource ConfirmPasswordValidationStyle}"/>
                </Grid>
                <Grid Grid.Row="3"
                      Style="{StaticResource FormGroupStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Column="0" 
                                Grid.Row="0"
                                Orientation="Horizontal">
                        <Image Source="pack://application:,,,/WpfPerfBench;component/Resources/Icons/cabinet.png"
                               Style="{StaticResource FormImageStyle}"/>
                        <Label Content="Тип базы данных"
                               Style="{StaticResource FormLabelStyle}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="0"
                              Grid.Row="1"
                              ItemsSource="{Binding DbTypes}"
                              SelectedValue="{Binding DbType, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource FormComboBoxStyle}"/>
                    <Label Grid.Column="0"
                           Grid.Row="2"
                           Content="🗄️ Тип базы данных" 
                           Visibility="Hidden"/>

                    <StackPanel Grid.Column="2"
                                Grid.Row="0" 
                                Orientation="Horizontal">
                        <Image Source="pack://application:,,,/WpfPerfBench;component/Resources/Icons/link.png"
                               Style="{StaticResource FormImageStyle}"/>
                        <Label Content="Connection String"
                                   Style="{StaticResource FormLabelStyle}"/>
                    </StackPanel>
                    <TextBox Grid.Column="2"
                             Grid.Row="1" 
                             x:Name="ConnectionStringTextBox"
                             Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"/>
                    <Label  Grid.Column="2"
                            Grid.Row="2" 
                            Style="{StaticResource ConnectionStringValidationStyle}"/>
                </Grid>
                <Grid Grid.Row="4"
                      Style="{StaticResource FormGroupStyle}">
                    <Button Content="Тест"
                            Command="{Binding TestCommand}"
                            Style="{StaticResource PrimaryBtnStyle}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
