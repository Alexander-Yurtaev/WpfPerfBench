<Window x:Class="WpfPerfBench.Views.ModalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfPerfBench.Views"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:WpfPerfBench.Behaviors"
        xmlns:commands="clr-namespace:WpfPerfBench.Commands"
        mc:Ignorable="d"
        Title="{Binding}"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModalDialogStyle}">

    <b:Interaction.Behaviors>
        <behaviors:DragMoveBehavior/>
    </b:Interaction.Behaviors>

    <Border Style="{StaticResource ModalDialogBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image Grid.Row="0" Source="{Binding IconSource}"
                   Width="80" Height="80"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0 0 0 12"/>
            <TextBlock Grid.Row="1" Text="{Binding Header}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0 0 0 8"/>
            <TextBlock Grid.Row="2" Text="{Binding Description}"
                       FontSize="15"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0 0 0 20"
                       LineHeight="22"
                       TextWrapping="WrapWithOverflow"/>
            <ItemsControl Grid.Row="3" 
                          ItemsSource="{Binding Commands}"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type commands:RelayUICommand}">
                        <Button Content="{Binding Title}"
                                Command="{Binding Command}"
                                Background="{DynamicResource Danger}"
                                Foreground="#ffff"
                                Padding="28 8"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="14"
                                Cursor="Hand"
                                MinWidth="80"/>
                        <!--border-radius: 10px;-->
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
