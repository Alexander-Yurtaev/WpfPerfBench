<UserControl x:Class="WpfPerfBench.Views.MigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Views"
             xmlns:behaviors="clr-namespace:WpfPerfBench.Behaviors"
             xmlns:controls="clr-namespace:WpfPerfBench.Controls"
             xmlns:designViewModels="clr-namespace:WpfPerfBench.DesignViewModels"
             mc:Ignorable="d" 
             d:DesignWidth="950" d:DesignHeight="791.38"
             d:DataContext="{d:DesignInstance Type=designViewModels:DesignMigrationViewModel, IsDesignTimeCreatable=True}">

    <Border behaviors:LoadActivator.IsActive="True"
            Style="{DynamicResource CardBorderStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Hidden" 
                      HorizontalScrollBarVisibility="Hidden">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Style="{StaticResource HeaderGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal">
                        <Image Source="pack://application:,,,/WpfPerfBench;component/Resources/Icons/box.png" 
                               Style="{StaticResource HeaderIconStyle}" />
                        <TextBlock Style="{StaticResource HeaderTextStyle}"
                                   Text="Управление миграциями"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CountBorderIndicatorStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Доступно: "
                                       Style="{StaticResource CountTextBlockIndicatorStyle}"/>
                            <TextBlock Text="{Binding MigrationCount, FallbackValue=0, Mode=OneWay}"
                                       Style="{StaticResource CountTextBlockIndicatorStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <ItemsControl Grid.Row="1" 
                              ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MigrationItem/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Row="2"
                        Content="Выполнить"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryBtnStyle}"
                        Command="{Binding ApplyMigrationsCommand}"/>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
