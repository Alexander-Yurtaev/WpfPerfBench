<UserControl x:Class="WpfPerfBench.Views.StandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPerfBench.Views"
             xmlns:behaviors="clr-namespace:WpfPerfBench.Behaviors"
             xmlns:designViewModels="clr-namespace:WpfPerfBench.DesignViewModels"
             xmlns:data="clr-namespace:WpfPerfBench.Data"
             xmlns:models="clr-namespace:WpfPerfBench.Data.Models;assembly=WpfPerfBench.Data"
             xmlns:controls="clr-namespace:WpfPerfBench.Controls"
             xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="450"
             d:DataContext="{d:DesignInstance Type=designViewModels:DesignStandViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <Style x:Key="HeaderStyle"
               TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgHeader}"/>
            <Setter Property="Padding" Value="25 7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style x:Key="HeaderIconStyle"
               TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="HeaderFioStyle"
               TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="HeaderSplitterStyle"
               TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style x:Key="HeaderDbInfoLabelStyle"
               TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HeaderDbInfoTextBlockStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TreeViewStyle"
               TargetType="TreeView">
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Background" Value="{DynamicResource BgTree}"/>
            <Setter Property="Padding" Value="10 15"/>
            <Setter Property="BorderThickness" Value="0 0 1 0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style x:Key="ItemsListViewStyle"
               TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource BgList}"/>
        </Style>
        <Style x:Key="TerminalContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgConsole}"/>
            <Setter Property="Padding" Value="14 10"/>
            <Setter Property="BorderThickness" Value="0 0 1 0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style x:Key="InfoContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
        </Style>
    </UserControl.Resources>

    <Grid behaviors:LoadActivator.IsActive="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Style="{StaticResource HeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" 
                       Style="{StaticResource HeaderIconStyle}"
                       Content="{Binding Icon, FallbackValue='👋'}" />
                <Label Grid.Column="1" 
                       Style="{StaticResource HeaderFioStyle}"
                       Content="{Binding Fio, FallbackValue='ФИО'}" />
                <Label Grid.Column="2" 
                       Style="{StaticResource HeaderSplitterStyle}"
                       Content="|" />
                <Label Grid.Column="3" 
                       Style="{StaticResource HeaderDbInfoLabelStyle}"
                       Content="{Binding DataProvider, FallbackValue='Пусто'}" />
                <Label Grid.Column="4" 
                       Style="{StaticResource HeaderSplitterStyle}"
                       Content="•" />
                <TextBlock Grid.Column="5" 
                       Style="{StaticResource HeaderDbInfoTextBlockStyle}"
                       Text="{Binding TotalRecordCount, StringFormat='N0', Mode=OneWay, FallbackValue='0'}" />
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TreeView Grid.Row="0"
                      Grid.Column="0"
                      behaviors:TreeViewHelper.IsActive="True"
                      ItemsSource="{Binding TreeItems}"
                      Style="{StaticResource TreeViewStyle}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Foreground="Beige">
                            <Run Text="{Binding Name, Mode=OneWay}"/>
                            <Run Text=" ("/>
                            <Run Text="{Binding ItemsCount, Mode=OneWay, StringFormat={}{0:N0}}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Background="{DynamicResource BgSecondary}">
                <ListView x:Name="ItemsListView"
                          ItemsSource="{Binding Items}"
                          Style="{StaticResource ItemsListViewStyle}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Item}">
                            <controls:ItemRow />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource TerminalContainerStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            BorderThickness="0 0 0 1"
                            BorderBrush="{DynamicResource BorderColor}">
                        <TextBlock Text=" Терминал производительности"
                                   Foreground="{DynamicResource TextMute}"
                                   FontSize="11"
                                   Margin="0 0 0 8"/>
                    </Border>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ConsoleManager.LogItems}"
                             Foreground="{DynamicResource TextConsole}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type data:LogItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat=hh:mm:ss}" Margin="0 0 20 0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="0 0 20 0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Value}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Row="1"
                    Grid.Column="1" 
                    Style="{StaticResource InfoContainerStyle}">
                <TabControl>
                    <TabControl.Resources>
                        <Style TargetType="Label">
                            <Setter Property="Foreground" Value="{DynamicResource TextMute}"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                        </Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="Детали"
                             DataContext="{Binding ElementName=ItemsListView,
                                                Path=SelectedItem}">
                        <Border Background="{DynamicResource BgWindow}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Hidden">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Column="0"
                                       Grid.Row="0"
                                       Content="CategoryId:"/>
                                    <TextBlock Grid.Column="1"
                                           Grid.Row="0"
                                           Text="{Binding CategoryId}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="1"
                                       Content="Name:"/>
                                    <TextBlock Grid.Column="1"
                                           Grid.Row="1"
                                           Text="{Binding Name}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="2"
                                       Content="Status:"/>
                                    <TextBlock Grid.Column="1"
                                           Grid.Row="2"
                                           Text="{Binding Status}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="3"
                                       Content="Priority:"/>
                                    <TextBlock Grid.Column="1" 
                                           Grid.Row="3"
                                           Text="{Binding Priority}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="4"
                                       Content="CreatedAt:"/>
                                    <TextBlock Grid.Column="1"
                                           Grid.Row="4"
                                           Text="{Binding CreatedAt, StringFormat=dd-MM-yyyy}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="5"
                                       Content="Price:"/>
                                    <TextBlock Grid.Column="1"
                                           Grid.Row="5"
                                           Text="{Binding Price, StringFormat=C}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="6"
                                       Content="Weight:"/>
                                    <TextBlock Grid.Column="1"
                                           Grid.Row="6"
                                           Text="{Binding Weight, StringFormat={}{0} кг}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="7"
                                       Content="IsFragile:"/>
                                    <CheckBox Grid.Column="1"
                                          Grid.Row="7"
                                          IsChecked="{Binding IsFragile}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="8"
                                       Content="IsUrgent:"/>
                                    <CheckBox Grid.Column="1"
                                          Grid.Row="8"
                                          IsChecked="{Binding IsUrgent}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="9"
                                       Content="Comments:"/>
                                    <TextBlock Grid.Column="1"
                                           Grid.Row="9"
                                           Text="{Binding Comments}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="10"
                                       Content="Latitude:"/>
                                    <TextBlock Grid.Column="1"
                                           Grid.Row="10"
                                           Text="{Binding Latitude}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="11"
                                       Content="Longitude:"/>
                                    <TextBlock Grid.Column="1"
                                           Grid.Row="11"
                                           Text="{Binding Longitude}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="12"
                                       Content="DeliveryLatitude:"/>
                                    <TextBlock Grid.Column="1"
                                           Grid.Row="12"
                                           Text="{Binding DeliveryLatitude}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="13"
                                       Content="DeliveryLongitude:"/>
                                    <TextBlock Grid.Column="1"
                                           Grid.Row="13"
                                           Text="{Binding DeliveryLongitude}"/>

                                    <Label Grid.Column="0"
                                       Grid.Row="14"
                                       Content="IsDeleted:"/>
                                    <CheckBox Grid.Column="1"
                                          Grid.Row="14"
                                          IsChecked="{Binding IsDeleted}"/>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                    <TabItem Header="Карта">
                        <gmap:GMapControl>
                            <b:Interaction.Behaviors>
                                <behaviors:GMapListViewBehavior SelectedItem="{Binding ElementName=ItemsListView,
                                                Path=SelectedItem}"/>
                            </b:Interaction.Behaviors>
                        </gmap:GMapControl>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
