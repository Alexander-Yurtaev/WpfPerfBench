<Window x:Class="WpfPerfBench.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfPerfBench"
        xmlns:controls="clr-namespace:WpfPerfBench.Controls"
        xmlns:behaviors="clr-namespace:WpfPerfBench.Behaviors"
        xmlns:viewModels="clr-namespace:WpfPerfBench.ViewModels"
        xmlns:views="clr-namespace:WpfPerfBench.Views"
        mc:Ignorable="d"
        Title="WPF Performance Demo" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        BorderThickness="0"
        Height="985" Width="900" ResizeMode="NoResize">

    <b:Interaction.Behaviors>
        <behaviors:DragMoveBehavior/>
    </b:Interaction.Behaviors>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close"
                        Executed="CloseCommandHandler" />
    </Window.CommandBindings>

    <Border Style="{DynamicResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <controls:Header Grid.Row="0" DataContext="{Binding Header}"/>
            <Border Grid.Row="1"
                    Style="{DynamicResource BorderContentStyle}">
                <ContentControl Content="{Binding CurrentViewModel}"
                                Validation.ErrorTemplate="{x:Null}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type viewModels:InitViewModel}">
                            <views:InitView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:MigrationViewModel}">
                            <views:MigrationView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:SeedViewModel}">
                            <views:SeedView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:StandViewModel}">
                            <views:StandView />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Border>
        </Grid>
    </Border>
</Window>
