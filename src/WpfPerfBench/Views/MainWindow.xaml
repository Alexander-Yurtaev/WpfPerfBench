<Window x:Class="WpfPerfBench.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfPerfBench"
        xmlns:controls="clr-namespace:WpfPerfBench.Controls"
        xmlns:behaviors="clr-namespace:WpfPerfBench.Behaviors"
        xmlns:viewModels="clr-namespace:WpfPerfBench.ViewModels"
        xmlns:views="clr-namespace:WpfPerfBench.Views"
        mc:Ignorable="d"
        Title="WPF Performance Demo" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Height="916" Width="612">

    <b:Interaction.Behaviors>
        <behaviors:DragMoveBehavior/>
    </b:Interaction.Behaviors>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close"
                        Executed="CloseCommandHandler" />
    </Window.CommandBindings>

    <Window.Resources>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BgWindow}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="Border"
               x:Key="CardBorderStyle">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20 20 20 25"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="400"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>
        <Style TargetType="Border"
               x:Key="BorderContentStyle">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="BorderBrush" Value="#d0d0d8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <controls:Header Grid.Column="0" 
                                 HeaderIcon="{Binding CurrentViewModel.HeaderIcon}"
                                 HeaderTitle="{Binding CurrentViewModel.HeaderTitle}"
                                 CurrentStep="{Binding CurrentStep}"
                                 TotalSteps="{Binding TotalSteps}"/>
            </Grid>
            <Border Grid.Row="1"
                    Style="{StaticResource BorderContentStyle}">
                <ContentControl Content="{Binding CurrentViewModel}"
                                Validation.ErrorTemplate="{x:Null}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type viewModels:InitViewModel}">
                            <views:InitView NextCommand="{Binding RelativeSource={RelativeSource AncestorType=views:MainWindow},
                                                                        Path=DataContext.NextCommand}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:StandViewModel}">
                            <views:StandView />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Border>
            <controls:Footer Grid.Row="2"
                             Title="{Binding CurrentViewModel.FooterTitle}"/>
        </Grid>
    </Border>
</Window>
